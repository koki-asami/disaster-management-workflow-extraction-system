# Disaster Management Workflow Extraction System
# Copy the relevant section into backend/.env and frontend/.env.local as needed.
# Never commit real secrets.

###############################################################################
# Backend runtime: backend/.env
###############################################################################

# Required
OPENAI_API_KEY=sk-your-openai-api-key
FLOWCHART_TABLE_NAME=flowcharts_dev
S3_BUCKET_NAME=dmwe-pdfs-dev

# AWS SDK region and credentials.
# Prefer IAM roles in AWS. Use local credentials only for development.
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# FastAPI / CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
LOG_LEVEL=INFO

# Authentication
# Local smoke only. Set false/omit in shared dev/prod.
AUTH_DISABLED=true
DEV_USER_SUB=dev-local

# Optional API key auth for server-to-server calls.
# Comma-separated values. Leave empty if unused.
API_KEYS=
API_KEY_USER_SUB=api-key-user

# Cognito JWT validation. Required when AUTH_DISABLED is false and Cognito is used.
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Async extraction queue.
# Local uvicorn can omit EXTRACTION_QUEUE_URL because it runs the worker in-process.
# AWS API runtime needs this when enqueueing to SQS.
EXTRACTION_QUEUE_URL=

# Extraction mode.
# batch is production default; sync is for local smoke/emergency fallback.
EXTRACTION_MODE=batch
BATCH_POLL_SECONDS=30
BATCH_TIMEOUT_SECONDS=86400
USE_STRUCTURED_LLM_OUTPUTS=1

# Optional explicit DynamoDB table overrides.
# By default these are derived from FLOWCHART_TABLE_NAME.
# UPLOADS_TABLE_NAME=flowcharts_dev_uploads
# EXTRACTION_JOBS_TABLE_NAME=flowcharts_dev_jobs

# Optional model overrides.
TASK_EXTRACTION_MODEL=gpt-5.2
DEPENDENCY_EXTRACTION_MODEL=gpt-5.2
CHAT_MODEL=gpt-5.2

###############################################################################
# Frontend runtime/build: frontend/.env.local or frontend/.env.production
###############################################################################

VITE_API_ORIGIN=http://127.0.0.1:8000
VITE_API_PREFIX=/api/v1

# Cognito Hosted UI. Leave empty for AUTH_DISABLED local development.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_APP_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/

# Local development only.
VITE_AUTH_DISABLED=true
VITE_ENABLE_DEV_TOKEN=true

# Legacy fallback names still read by config.js / logger.js.
# Prefer VITE_* for new work.
# REACT_APP_API_ORIGIN=http://127.0.0.1:8000
# REACT_APP_API_PREFIX=/api/v1
# REACT_APP_LOG_LEVEL=INFO

###############################################################################
# GitHub Actions repository Variables/Secrets
###############################################################################

# Secret:
# AWS_ROLE_TO_ASSUME=arn:aws:iam::<account-id>:role/<github-oidc-role>

# Variables:
# AWS_REGION=ap-northeast-1
# BACKEND_API_URL_DEV=https://api-dev.example.com
# BACKEND_API_URL_PROD=https://api.example.com
# VITE_COGNITO_DOMAIN_DEV=https://your-dev-domain.auth.ap-northeast-1.amazoncognito.com
# VITE_COGNITO_DOMAIN_PROD=https://your-domain.auth.ap-northeast-1.amazoncognito.com
# VITE_COGNITO_APP_CLIENT_ID_DEV=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_APP_CLIENT_ID_PROD=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_REDIRECT_URI_DEV=https://app-dev.example.com/
# VITE_COGNITO_REDIRECT_URI_PROD=https://app.example.com/
# VITE_COGNITO_LOGOUT_URI_DEV=https://app-dev.example.com/
# VITE_COGNITO_LOGOUT_URI_PROD=https://app.example.com/
# CLOUDFRONT_DISTRIBUTION_ID_DEV=
# CLOUDFRONT_DISTRIBUTION_ID_PROD=
