# Backend runtime example.
# Copy to backend/.env and fill real values. Never commit backend/.env.

# Required
OPENAI_API_KEY=sk-your-openai-api-key
FLOWCHART_TABLE_NAME=flowcharts_dev
S3_BUCKET_NAME=dmwe-pdfs-dev
# 保存済みフローの肥大データ（Mermaid offload / React Flow graph_data）の S3 プレフィックス。
# 未設定時は saved-flowcharts/v2 → saved-flowcharts/v2/<location>/charts|graph_data/...
# 従来の {location}/charts|graph_data のみにしたい場合:
# FLOWCHART_S3_ROOT=

# AWS SDK region and local credentials.
# Prefer IAM roles in AWS.
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# FastAPI / CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
LOG_LEVEL=INFO

# Authentication
AUTH_DISABLED=true
DEV_USER_SUB=dev-local
API_KEYS=
API_KEY_USER_SUB=api-key-user
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Async extraction
EXTRACTION_QUEUE_URL=
EXTRACTION_MODE=batch
BATCH_POLL_SECONDS=30
BATCH_TIMEOUT_SECONDS=86400
USE_STRUCTURED_LLM_OUTPUTS=1

# Optional DynamoDB table overrides
# UPLOADS_TABLE_NAME=flowcharts_dev_uploads
# EXTRACTION_JOBS_TABLE_NAME=flowcharts_dev_jobs

# Optional model overrides
TASK_EXTRACTION_MODEL=gpt-5.2
DEPENDENCY_EXTRACTION_MODEL=gpt-5.2
CHAT_MODEL=gpt-5.2
