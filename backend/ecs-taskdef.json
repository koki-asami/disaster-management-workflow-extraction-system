{
  "family": "dmwe-api-dev",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::050451363686:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::050451363686:role/dmwe-api-dev-task",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "PLACEHOLDER_IMAGE_URI",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "AWS_REGION", "value": "ap-northeast-1" },
        { "name": "FLOWCHART_TABLE_NAME", "value": "flowcharts_dev" },
        { "name": "S3_BUCKET_NAME", "value": "dmwe-pdfs-dev" },
        { "name": "AUTH_DISABLED", "value": "true" },
        { "name": "DEV_USER_SUB", "value": "dev-local" },
        { "name": "CORS_ALLOW_ORIGINS", "value": "https://d35lrsfh7k3t36.cloudfront.net" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "EXTRACTION_MODE", "value": "sync" },
        { "name": "USE_STRUCTURED_LLM_OUTPUTS", "value": "1" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/dmwe-api-dev",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3); sys.exit(0)\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
