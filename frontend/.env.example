# Frontend Vite env example.
# Copy to frontend/.env.local for local development or frontend/.env.production for production-like builds.

VITE_API_ORIGIN=http://127.0.0.1:8000
VITE_API_PREFIX=/api/v1

# Cognito Hosted UI. Leave empty for local AUTH_DISABLED development.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_APP_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/

# Local development only.
VITE_AUTH_DISABLED=true
VITE_ENABLE_DEV_TOKEN=true

# Legacy fallback names still read by config.js / logger.js.
# Prefer VITE_* for new work.
# REACT_APP_API_ORIGIN=http://127.0.0.1:8000
# REACT_APP_API_PREFIX=/api/v1
# REACT_APP_LOG_LEVEL=INFO
